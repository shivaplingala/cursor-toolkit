{
  "_comment": "Attach this to the IAM user/role whose credentials you give to the aws-readonly-diagnostics skill. It grants ONLY read/describe/list/get across the services this skill uses, so even a bug or misuse cannot mutate your account. For the broadest safe option, AWS's managed policies 'ReadOnlyAccess' (read incl. data) or 'ViewOnlyAccess' (metadata only) also work. This custom policy is tighter: diagnostic reads only, plus an explicit deny on the credential-minting / data-exfil actions the skill already blocks in software, as defense in depth.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DiagnosticReadOnly",
      "Effect": "Allow",
      "Action": [
        "logs:Describe*",
        "logs:Get*",
        "logs:List*",
        "logs:FilterLogEvents",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "s3:GetObject",
        "s3:GetObjectAcl",
        "s3:GetObjectTagging",
        "s3:ListBucket",
        "s3:ListAllMyBuckets",
        "s3:GetBucketPolicy",
        "s3:GetBucketAcl",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketCORS",
        "s3:GetLifecycleConfiguration",
        "lambda:Get*",
        "lambda:List*",
        "ec2:Describe*",
        "ec2:GetConsoleOutput",
        "ecs:Describe*",
        "ecs:List*",
        "rds:Describe*",
        "rds:List*",
        "elasticloadbalancing:Describe*",
        "apigateway:GET",
        "dynamodb:Describe*",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:List*",
        "iam:Get*",
        "iam:List*",
        "iam:SimulatePrincipalPolicy",
        "iam:SimulateCustomPolicy",
        "cloudtrail:LookupEvents",
        "cloudtrail:Get*",
        "cloudtrail:Describe*",
        "cloudtrail:List*",
        "sns:Get*",
        "sns:List*",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueues",
        "states:Describe*",
        "states:List*",
        "states:GetExecutionHistory",
        "ce:Get*",
        "ce:Describe*",
        "ce:List*",
        "health:Describe*",
        "support:Describe*",
        "cloudformation:Describe*",
        "cloudformation:Get*",
        "cloudformation:List*",
        "autoscaling:Describe*",
        "elasticache:Describe*",
        "route53:Get*",
        "route53:List*",
        "kms:Describe*",
        "kms:Get*",
        "kms:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyCredentialMintingAndExfil",
      "Effect": "Deny",
      "Action": [
        "sts:AssumeRole",
        "sts:GetSessionToken",
        "sts:GetFederationToken",
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "lambda:InvokeFunction",
        "ssm:SendCommand",
        "ssm:StartSession",
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    }
  ]
}